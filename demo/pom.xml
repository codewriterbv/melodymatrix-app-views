<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>be.codewriter</groupId>
        <artifactId>viewers-parent</artifactId>
        <version>1.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>viewers-demo</artifactId>
    <packaging>jar</packaging>
    <description>Standalone test application to try the views with simulated MIDI and audio input.</description>

    <dependencies>
        <dependency>
            <groupId>be.codewriter</groupId>
            <artifactId>viewers</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>software.coley</groupId>
            <artifactId>bento-fx</artifactId>
            <version>${bentofx.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- mvn javafx:run starts the test application -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>be.codewriter.melodymatrix.view.demo.TestLauncher</mainClass>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
