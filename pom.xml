<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>be.codewriter</groupId>
    <artifactId>viewers-parent</artifactId>
    <version>1.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
        model : the shared domain and event model (notes, chords, MIDI/play events). Pure Kotlin,
                no JavaFX, so non-UI code (like the MelodyMatrix engine) can depend on it.
        views : the JavaFX visualisations, built on the model.
        demo  : a standalone test application to try the views without the MelodyMatrix app.
    -->
    <modules>
        <module>model</module>
        <module>views</module>
        <module>demo</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>27</maven.compiler.source>
        <maven.compiler.target>27</maven.compiler.target>
        <kotlin.version>2.3.20</kotlin.version>

        <!-- Dependency versions -->
        <atlantafx.version>2.1.0</atlantafx.version>
        <bentofx.version>0.15.1</bentofx.version>
        <charts.version>21.0.27</charts.version>
        <javafx.version>27</javafx.version>
        <jserial.version>2.11.0</jserial.version>
        <kotlin.coroutines.version>1.10.2</kotlin.coroutines.version>
        <kotlin.serialization.version>1.11.0</kotlin.serialization.version>
        <log4j.version>2.25.3</log4j.version>
        <sheetmusic4j.version>0.0.1</sheetmusic4j.version>

        <!-- Test dependency versions -->
        <junit.version>5.10.2</junit.version>

        <!-- Plugin versions -->
        <javafx.maven.version>0.0.8</javafx.maven.version>
        <maven.shade.version>3.4.1</maven.shade.version>
        <maven.enforcer.version>3.6.3</maven.enforcer.version>
    </properties>

    <!-- This build has no parent pom, so JavaFX alignment is managed locally.
         All JavaFX modules must resolve to the same version; javafx-graphics and
         javafx-base arrive transitively via com.sheetmusic4j:fxviewer at an older
         version, which Maven's nearest-wins rule would otherwise prefer over the
         version this build compiles against. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>be.codewriter</groupId>
                <artifactId>viewers-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>be.codewriter</groupId>
                <artifactId>viewers</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-base</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-graphics</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-media</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-swing</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sheetmusic4j</groupId>
                <artifactId>core</artifactId>
                <version>${sheetmusic4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sheetmusic4j</groupId>
                <artifactId>fxviewer</artifactId>
                <version>${sheetmusic4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Test dependencies, shared by all modules -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The libraries only use the Log4j API; tests need a backend to log to -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>${javafx.maven.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven.shade.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- `mvn javafx:run` from this directory starts the demo application; the other
                 modules are libraries, so the plugin is skipped there (demo/pom.xml enables it) -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>be.codewriter.melodymatrix.view.demo.TestLauncher</mainClass>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <!-- Kotlin plugin -->
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                        <arg>-opt-in=kotlin.ExperimentalStdlibApi</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>kotlinx-serialization</plugin>
                    </compilerPlugins>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-serialization</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
